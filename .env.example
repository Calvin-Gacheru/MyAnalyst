# Copy to .env and fill in. .env is git-ignored: never commit real values.

DEEPSEEK_API_KEY=
MYANALYST_LLM_MODEL=deepseek-chat

# PostgreSQL + pgvector from docker-compose.yml. If another PostgreSQL already
# uses port 5432 on your machine, map the container to e.g. 5433 and use that here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myanalyst

# Required. Signs access-token JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MYANALYST_JWT_SECRET=

# Optional (defaults shown)
# MYANALYST_ACCESS_TOKEN_MINUTES=15
# MYANALYST_REFRESH_TOKEN_DAYS=30
# MYANALYST_CORS_ORIGINS=
# Development only: skip sign-in so the web frontend works without login.
# MYANALYST_AUTH_DISABLED=1
# Mainland China: download the embedding model through a mirror.
# HF_ENDPOINT=https://hf-mirror.com
